{
  "name": "ssmart-pos",
  "version": "1.0.0",
  "description": "SS Mart — Offline-first POS and inventory management",
  "main": "electron/main.js",
  "author": "Manideep Daram",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build:all && electron-builder --win",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "build:backend": "cd backend && npm install && npx prisma generate",
    "build:frontend": "cd frontend && npm install && npx next build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ssmart.pos",
    "productName": "SS Mart",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SS Mart POS"
    }
  }
}
