datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("admin") // "admin" | "manager" | "accountant" | "cashier"
  permissions String   @default("[]") // JSON array of permission strings
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  draftBills  DraftBill[]
}

model ShopSettings {
  id             Int      @id @default(autoincrement())
  shopName       String
  legalName      String?
  address1       String
  address2       String?
  city           String?
  state          String?
  phone          String?
  email          String?
  // Currency
  currencyCode   String   @default("INR") // INR | USD | EUR | GBP
  currencySymbol String   @default("Rs.")
  // Tax / GST
  gstEnabled     Boolean  @default(false)
  gstNumber      String?
  panNumber      String?
  defaultTaxRate Float    @default(0)
  // Loyalty
  loyaltyEnabled Boolean  @default(false)
  pointsPerUnit  Float    @default(0) // points earned per 1 currency unit spent
  pointValue     Float    @default(0) // currency value of 1 point when redeemed
  // Receipt customisation
  receiptHeader  String?
  receiptFooter  String   @default("Thank You! Visit Again.")
  showGst        Boolean  @default(true)
  autoPrintReceipt Boolean @default(false)
  // Direct-USB (ESC/POS) printing — see backend/src/lib/escposReceipt.js.
  // Paper width in mm; only 58 or 80 are meaningful (drives the fixed
  // monospace column count for the raw text layout).
  usbPrinterWidth Int @default(80)
  // How a receipt prints when "auto-print after sale" is on:
  //   "browser" — the OS/browser print dialog (window.print), the default
  //               and what a Windows machine with a printer driver uses.
  //   "usb"     — raw ESC/POS straight to the USB thermal printer, with NO
  //               modal dialog. Required on a headless/kiosk Debian till
  //               where the browser print dialog has no configured printer
  //               and would otherwise hang the screen after every sale.
  autoPrintMethod String @default("browser")
  // Inventory
  lowStockAlert  Int      @default(5)
  allowNegativeStock Boolean @default(false)
  // Address lookup (see PinCode below)
  pincode        String?
  // Backup & daily auto-backup schedule (cron syntax, default "0 2 * * *")
  backupSchedule String  @default("0 2 * * *")
  // Retention (days) for local backup files, default 30
  backupRetention Int    @default(30)
  // Whether HSN code appears on PDF receipts (default false, thermal always omits)
  showHsnOnPdf    Boolean @default(false)
}

model Product {
  id            Int           @id @default(autoincrement())
  barcode       String        @unique
  name          String
  category      String?
  hsn           String?
  unit          String? // UQC code, e.g. "PCS", "KGS" — see frontend/lib/masters.ts UQC_UNITS
  purchasePrice Float
  sellingPrice  Float
  taxRate       Float         @default(0) // GST % for this product
  discountType  String?       // "percent" | "amount" | null (no standing discount)
  discountValue Float         @default(0) // interpreted per discountType; applied automatically at checkout
  stock         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoiceItems  InvoiceItem[]
  returnItems   ReturnItem[]
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String    @unique
  email         String?
  loyaltyPoints Int       @default(0)
  totalSpent    Float     @default(0)
  totalDue      Float     @default(0) // outstanding credit ("udhaar") owed by this customer
  creditBalance Float     @default(0) // store credit owed TO the customer (e.g. from a return kept as balance)
  visits        Int       @default(0)
  createdAt     DateTime  @default(now())
  invoices      Invoice[]
  duePayments   CustomerDuePayment[]
  returns       Return[]
}

// A record of each payment a customer makes against their running due
// balance — kept as its own audit trail rather than just decrementing
// Customer.totalDue with no history.
model CustomerDuePayment {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Float
  note       String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  customerId     Int?
  customerName   String        @default("Walk-in Customer")
  customerPhone  String?
  subtotal       Float // sum of line bases, pre-discount, pre-tax
  discountType   String? // "percent" | "amount"
  discountValue  Float         @default(0)
  discountAmount Float         @default(0) // manual discount in currency
  taxAmount      Float         @default(0)
  loyaltyDiscount Float        @default(0) // currency value of redeemed points
  totalAmount    Float // final payable
  paymentMethod  String        @default("CASH") // CASH | UPI | CARD
  amountPaid     Float         @default(0)
  changeDue      Float         @default(0)
  dueAmount      Float         @default(0) // unpaid shortfall added to the customer's running due ("udhaar")
  previousDuePaid Float        @default(0) // old due the customer cleared as part of this same bill
  returnValue    Float         @default(0) // value of items returned on this bill, netted against the sale
  creditApplied  Float         @default(0) // store credit the customer spent on this bill
  refundValue    Float         @default(0) // paid back to the customer (returns beyond the purchase) as cash or credit
  refundMode     String? // "CASH" | "CREDIT" — how refundValue was settled
  pointsRedeemed Int           @default(0)
  pointsEarned   Int           @default(0)
  createdAt      DateTime      @default(now())
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          InvoiceItem[]
  payments       InvoicePayment[]
  returns        Return[]
}

// Individual payment line on an invoice — supports split payments
// (e.g. ₹200 cash + ₹50 UPI in a single transaction)
model InvoicePayment {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    String  // "CASH" | "UPI" | "CARD"
  amount    Float
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  name      String
  unit      String? // snapshot of the product's UQC at time of sale
  quantity  Int
  price     Float // unit selling price at time of sale
  taxRate   Float   @default(0)
  taxAmount Float   @default(0) // tax for this line (on discounted base)
  total     Float // line total incl. tax, after prorated discount
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]
}

// A return against a past invoice — one or more line items, each capped at
// (quantity sold - quantity already returned) so the same unit can't be
// returned twice. "Returned quantity so far" is always computed by summing
// ReturnItem rows for an invoice item (see routes/returns.js) rather than
// stored as a running counter, matching CustomerDuePayment's audit-trail
// pattern elsewhere in this schema.
model Return {
  id           Int          @id @default(autoincrement())
  invoiceId    Int
  customerId   Int?
  totalRefund  Float
  refundMethod String // "CASH" | "UPI" | "CARD" | "DUE_ADJUST"
  note         String?
  createdAt    DateTime     @default(now())
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  items        ReturnItem[]
}

model ReturnItem {
  id            Int         @id @default(autoincrement())
  returnId      Int
  invoiceItemId Int
  productId     Int
  name          String
  quantity      Int
  refundAmount  Float
  return        Return      @relation(fields: [returnId], references: [id])
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}

// --- Bulk reference data, admin-imported from CSV (see routes/masters.js) ---
// Large/volatile government datasets (full HSN/SAC catalogs, PIN codes,
// IFSC) are deliberately NOT bundled with the app — see README > Reference
// data & validation. These tables just give the admin somewhere to load
// the official file into, if/when they want autocomplete and lookups.

model TaxCode {
  id          Int     @id @default(autoincrement())
  type        String // "HSN" | "SAC"
  code        String
  description String
  gstRate     Float?

  @@unique([type, code])
}

model PinCode {
  pincode  String  @id
  area     String?
  district String?
  state    String?
}

model IfscCode {
  ifsc     String  @id
  bank     String?
  branch   String?
  address  String?
  district String?
  state    String?
}

model DraftBill {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  label     String?
  state     String
  isHeld    Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, label])
}

// ═══════════════════════════════════════════════════════════════════════
// ACCOUNTING MODULE — Double-entry bookkeeping (MARG ERP replacement)
// ═══════════════════════════════════════════════════════════════════════

model AccountGroup {
  id         Int      @id @default(autoincrement())
  code       String   @unique // e.g. "1.1.3"
  name       String
  parentId   Int?
  parent     AccountGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children   AccountGroup[] @relation("GroupTree")
  nature     String         // "debit" | "credit"
  reportType String         // "balance_sheet" | "profit_loss"
  // Classification flags (replaces hardcoded code prefix checks)
  bsCategory String?        // "asset" | "liability" | "capital" — balance sheet classification
  cfCategory String?        // "operating" | "investing" | "financing" — cash flow classification
  isSystem   Boolean  @default(false) // built-in groups can't be deleted
  createdAt  DateTime @default(now())
  ledgers    Ledger[]
}

model Ledger {
  id            Int      @id @default(autoincrement())
  name          String
  groupId       Int
  group         AccountGroup @relation(fields: [groupId], references: [id])
  openingDebit  Float    @default(0)
  openingCredit Float    @default(0)
  isSystem      Boolean  @default(false)
  linkedEntityType String? // "customer" | "supplier" | null
  linkedEntityId   Int?
  // Purpose tag: used by auto-journal to find the right ledger dynamically
  // e.g. "cash", "bank", "sales", "purchases", "gst_cgst", "gst_sgst",
  // "gst_igst", "discount_allowed", "capital", "receivable", "payable"
  purpose       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  journalLines  JournalLine[]
  balances      LedgerBalance[]
  expenses      Expense[]
  @@unique([groupId, name])
}

model LedgerBalance {
  id             Int      @id @default(autoincrement())
  ledgerId       Int
  ledger         Ledger   @relation(fields: [ledgerId], references: [id])
  yearStart      DateTime // financial year start (e.g. 2026-04-01)
  openingDebit   Float    @default(0)
  openingCredit  Float    @default(0)
  debitTotal     Float    @default(0)
  creditTotal    Float    @default(0)
  closingBalance Float    @default(0)
  @@unique([ledgerId, yearStart])
}

model FinancialYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique // "2026-27"
  startDate DateTime @unique
  endDate   DateTime @unique
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Journal {
  id            Int      @id @default(autoincrement())
  voucherNumber String   @unique
  date          DateTime
  type          String   // "sales" | "purchase" | "payment" | "receipt" | "journal" | "contra" | "credit_note" | "debit_note"
  referenceType String?  // "invoice" | "return" | "payment" | null
  referenceId   Int?
  narration     String?
  totalDebit    Float    @default(0)
  totalCredit   Float    @default(0)
  isApproved    Boolean  @default(true)
  createdBy     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         JournalLine[]
  reconciliations BankReconciliation[]
  @@index([date])
  @@index([type])
}

model JournalLine {
  id        Int     @id @default(autoincrement())
  journalId Int
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledgerId  Int
  ledger    Ledger  @relation(fields: [ledgerId], references: [id])
  debit     Float   @default(0)
  credit    Float   @default(0)
  taxType   String? // "CGST" | "SGST" | "IGST" | null
  taxAmount Float   @default(0)
}

model Expense {
  id           Int      @id @default(autoincrement())
  date         DateTime
  ledgerId     Int
  ledger       Ledger   @relation(fields: [ledgerId], references: [id])
  amount       Float
  paymentMode  String   // "cash" | "bank" | "upi"
  bankLedgerId Int?
  reference    String?
  narration    String?
  partyName    String?
  createdBy    Int
  createdAt    DateTime @default(now())
}

model BankReconciliation {
  id            Int      @id @default(autoincrement())
  journalId     Int
  journal       Journal  @relation(fields: [journalId], references: [id])
  statementDate DateTime
  statementRef  String?
  reconciled    Boolean  @default(false)
  reconciledAt  DateTime?
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
}

model CostCenter {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MigrationLog {
  id              Int      @id @default(autoincrement())
  source          String   // "marg" | "tally" | "manual"
  dataType        String   // "ledgers" | "products" | "customers" | "opening_balances"
  filename        String?
  recordsImported Int      @default(0)
  recordsSkipped  Int      @default(0)
  errors          String?
  status          String   // "success" | "partial" | "failed"
  createdBy       Int
  createdAt       DateTime @default(now())
}
