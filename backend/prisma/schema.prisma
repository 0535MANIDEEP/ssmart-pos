datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("admin") // "admin" | "manager" | "accountant" | "cashier"
  permissions String   @default("[]") // JSON array of permission strings
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  draftBills  DraftBill[]
}

model Salesman {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  invoices  Invoice[]
}

model ShopSettings {
  id             Int      @id @default(autoincrement())
  shopName       String
  legalName      String?
  address1       String
  address2       String?
  city           String?
  state          String?
  phone          String?
  email          String?
  // Currency
  currencyCode   String   @default("INR") // INR | USD | EUR | GBP
  currencySymbol String   @default("Rs.")
  // Tax / GST
  gstEnabled     Boolean  @default(false)
  gstNumber      String?
  panNumber      String?
  defaultTaxRate Float    @default(0)
  // Loyalty
  loyaltyEnabled Boolean  @default(false)
  pointsPerUnit  Float    @default(0) // points earned per 1 currency unit spent
  pointValue     Float    @default(0) // currency value of 1 point when redeemed
  // Receipt customisation
  receiptHeader  String?
  receiptFooter  String   @default("Thank You! Visit Again.")
  showGst        Boolean  @default(true)
  autoPrintReceipt Boolean @default(false)
  // Direct-USB (ESC/POS) printing
  usbPrinterWidth Int @default(80)
  // "browser" | "usb"
  autoPrintMethod String @default("browser")
  // Inventory
  lowStockAlert  Int      @default(5)
  allowNegativeStock Boolean @default(false)
  // Address lookup
  pincode        String?
  // Backup & daily auto-backup schedule (cron syntax, default "0 2 * * *")
  backupSchedule String  @default("0 2 * * *")
  // Retention (days) for local backup files, default 30
  backupRetention Int    @default(30)
  // Whether HSN code appears on PDF receipts (default false, thermal always omits)
  showHsnOnPdf    Boolean @default(false)
}

model Product {
  id            Int           @id @default(autoincrement())
  barcode       String        @unique
  name          String
  category      String?
  hsn           String?
  unit          String? // UQC code, e.g. "PCS", "KGS"
  purchasePrice Float          // cost price from supplier
  mrp           Float          // MRP (Maximum Retail Price) — GST-inclusive, printed on label
  sellingPrice  Float          // Our selling price (actual price charged, must be <= MRP)
  rateA         Float?         // Rate A — Wholesale rate (GST-inclusive)
  rateB         Float?         // Rate B — Retail rate (GST-inclusive)
  rateC         Float?         // Rate C — Special/Dealer rate (GST-inclusive)
  taxRate       Float         @default(0) // GST % for this product
  discountType  String?       // "percent" | "amount" | null (no standing discount)
  discountValue Float         @default(0) // interpreted per discountType; applied automatically at checkout
  stock         Int           @default(0)
  minStock      Int           @default(0) // reorder alert threshold
  expiryDate    DateTime?     // product expiry date
  batchNumber   String?       // batch/lot number
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoiceItems  InvoiceItem[]
  returnItems   ReturnItem[]
  purchaseItems PurchaseItem[]
  // BOM / Packing fields
  isBulk        Boolean       @default(false) // true = sold in bulk, not directly at POS
  packSize      Float?        // pack size (e.g. 1 for 1kg, 5 for 5kg)
  bulkProductId Int?          // links to bulk parent product
  bulkProduct   Product?      @relation("BulkToPack", fields: [bulkProductId], references: [id], onDelete: Restrict)
  packedItems   Product[]     @relation("BulkToPack")
  // BOM relations
  outputBoms    BillOfMaterial[] // BOMs that produce this product
  bomItems      BomItem[]        // BOMs that consume this product as ingredient
  // Packing relations
  packingsAsBulk  Packing[] @relation("PackingBulk") // packings where this is the bulk item
  packingsAsPack  Packing[] @relation("PackingPack") // packings where this is the packed item
  @@index([category])
  @@index([isBulk])
}

// ═══════════════════════════════════════════════════════════════
// PACKING MODULE
// ═══════════════════════════════════════════════════════════════

model Packing {
  id            Int      @id @default(autoincrement())
  bulkProductId Int
  packProductId Int
  packWeight    Float    // weight in grams (e.g. 500, 250, 1000)
  packLabel     String   // e.g. "500 g"
  mrp           Float    // MRP shown on label (GST-inclusive)
  sellingPrice  Float    // Our selling price (GST-inclusive)
  purchasePrice Float    // Derived from bulk cost per gram
  taxRate       Float    @default(0) // GST % for this pack
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  bulkProduct Product @relation("PackingBulk", fields: [bulkProductId], references: [id], onDelete: Restrict)
  packProduct Product @relation("PackingPack", fields: [packProductId], references: [id], onDelete: Restrict)
}

// ═══════════════════════════════════════════════════════════════════════
// SUPPLIER & PURCHASE MODULE
// ═══════════════════════════════════════════════════════════════════════

model Supplier {
  id             Int              @id @default(autoincrement())
  name           String
  gstin          String?
  phone          String?
  email          String?
  address1       String?
  address2       String?
  city           String?
  state          String?
  pincode        String?
  contactPerson  String?
  paymentTerms   String?          // e.g. "Net 30", "Cash", "Credit 15 days"
  outstandingBalance Float        @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseInvoices PurchaseInvoice[]
  @@unique([name])
}

model PurchaseInvoice {
  id               Int             @id @default(autoincrement())
  supplierId       Int
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceNumber    String
  date             DateTime
  dueDate          DateTime?
  subtotal         Float           @default(0)
  discountType     String?         // "percent" | "amount" | null
  discountAmount   Float           @default(0)
  taxAmount        Float           @default(0)
  totalAmount      Float           @default(0)
  amountPaid       Float           @default(0)
  status           String          @default("pending") // "pending" | "partial" | "paid" | "returned"
  paymentMethod    String?         // "CASH" | "UPI" | "CARD" | "BANK_TRANSFER" | "CREDIT"
  notes            String?
  createdBy        Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            PurchaseItem[]
  @@index([date])
  @@index([supplierId])
  @@unique([supplierId, invoiceNumber])
}

model PurchaseItem {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  name              String
  quantity          Int
  unitCost          Float           // cost per unit (excl. tax)
  discountType      String?         // "percent" | "amount" | null
  discountValue     Float           @default(0)
  taxRate           Float           @default(0)
  taxAmount         Float           @default(0)
  total             Float           @default(0)
  batchNumber       String?
  expiryDate        DateTime?
}

// ═══════════════════════════════════════════════════════════════════════
// BILL OF MATERIALS (BOM) — for packing / repacking
// ═══════════════════════════════════════════════════════════════════════

model BillOfMaterial {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  outputProductId Int
  outputProduct   Product  @relation(fields: [outputProductId], references: [id], onDelete: Restrict)
  outputQuantity  Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           BomItem[]
  @@unique([name])
}

model BomItem {
  id            Int             @id @default(autoincrement())
  bomId         Int
  bom           BillOfMaterial  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Float
  unit          String?         // "KGS", "LITRES", "PCS"
  cost          Float           @default(0)
}

model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String    @unique
  email         String?
  rateTier      String    @default("B") // "A" (wholesale) | "B" (retail) | "C" (special)
  loyaltyPoints Int       @default(0)
  totalSpent    Float     @default(0)
  totalDue      Float     @default(0)
  creditBalance Float     @default(0)
  visits        Int       @default(0)
  createdAt     DateTime  @default(now())
  invoices      Invoice[]
  duePayments   CustomerDuePayment[]
  returns       Return[]
}

model CustomerDuePayment {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Float
  note       String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  customerId     Int?
  customerName   String        @default("Walk-in Customer")
  customerPhone  String?
  salesmanId     Int?
  subtotal       Float
  discountType   String?       // "percent" | "amount"
  discountValue  Float         @default(0)
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  loyaltyDiscount Float        @default(0)
  totalAmount    Float
  paymentMethod  String        @default("CASH")
  amountPaid     Float         @default(0)
  changeDue      Float         @default(0)
  dueAmount      Float         @default(0)
  previousDuePaid Float        @default(0)
  returnValue    Float         @default(0)
  creditApplied  Float         @default(0)
  refundValue    Float         @default(0)
  refundMode     String?
  pointsRedeemed Int           @default(0)
  pointsEarned   Int           @default(0)
  createdAt      DateTime      @default(now())
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesman       Salesman?     @relation(fields: [salesmanId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       InvoicePayment[]
  returns        Return[]
  @@index([customerId])
  @@index([createdAt])
}

model InvoicePayment {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    String
  amount    Float
  @@index([invoiceId])
}

model InvoiceItem {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  productId     Int
  name          String
  unit          String?
  rateTier      String?
  quantity      Int
  price         Float
  discountType  String?
  discountValue Float   @default(0)
  taxRate       Float   @default(0)
  taxAmount     Float   @default(0)
  total         Float
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems   ReturnItem[]
  @@index([productId])
}

model Return {
  id           Int          @id @default(autoincrement())
  invoiceId    Int
  customerId   Int?
  totalRefund  Float
  refundMethod String
  note         String?
  createdAt    DateTime     @default(now())
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        ReturnItem[]
  @@index([invoiceId])
  @@index([customerId])
}

model ReturnItem {
  id            Int         @id @default(autoincrement())
  returnId      Int
  invoiceItemId Int
  productId     Int
  name          String
  quantity      Int
  refundAmount  Float
  return        Return      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([returnId])
  @@index([invoiceItemId])
  @@index([productId])
}

// --- Bulk reference data, admin-imported from CSV (see routes/masters.js) ---

model TaxCode {
  id          Int     @id @default(autoincrement())
  type        String // "HSN" | "SAC"
  code        String
  description String
  gstRate     Float?

  @@unique([type, code])
}

model PinCode {
  pincode  String  @id
  area     String?
  district String?
  state    String?
}

model IfscCode {
  ifsc     String  @id
  bank     String?
  branch   String?
  address  String?
  district String?
  state    String?
}

model DraftBill {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  state     String
  isHeld    Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, label])
}

// ═══════════════════════════════════════════════════════════════════════
// ACCOUNTING MODULE — Double-entry bookkeeping
// ═══════════════════════════════════════════════════════════════════════

model AccountGroup {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  parentId   Int?
  parent     AccountGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   AccountGroup[] @relation("GroupTree")
  nature     String         // "debit" | "credit"
  reportType String         // "balance_sheet" | "profit_loss"
  bsCategory String?        // "asset" | "liability" | "capital"
  cfCategory String?        // "operating" | "investing" | "financing"
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  ledgers    Ledger[]
  @@index([parentId])
}

model Ledger {
  id            Int      @id @default(autoincrement())
  name          String
  groupId       Int
  group         AccountGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  openingDebit  Float    @default(0)
  openingCredit Float    @default(0)
  isSystem      Boolean  @default(false)
  linkedEntityType String?
  linkedEntityId   Int?
  purpose       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  journalLines  JournalLine[]
  balances      LedgerBalance[]
  expenses      Expense[]
  @@unique([groupId, name])
  @@index([purpose])
}

model LedgerBalance {
  id             Int      @id @default(autoincrement())
  ledgerId       Int
  ledger         Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  yearStart      DateTime
  openingDebit   Float    @default(0)
  openingCredit  Float    @default(0)
  debitTotal     Float    @default(0)
  creditTotal    Float    @default(0)
  closingBalance Float    @default(0)
  @@unique([ledgerId, yearStart])
}

model FinancialYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime @unique
  endDate   DateTime @unique
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Journal {
  id            Int      @id @default(autoincrement())
  voucherNumber String   @unique
  date          DateTime
  type          String
  referenceType String?
  referenceId   Int?
  narration     String?
  totalDebit    Float    @default(0)
  totalCredit   Float    @default(0)
  isApproved    Boolean  @default(true)
  createdBy     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         JournalLine[]
  reconciliations BankReconciliation[]
  @@index([date])
  @@index([type])
}

model JournalLine {
  id        Int     @id @default(autoincrement())
  journalId Int
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledgerId  Int
  ledger    Ledger  @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  debit     Float   @default(0)
  credit    Float   @default(0)
  taxType   String?
  taxAmount Float   @default(0)
  @@index([ledgerId])
  @@index([journalId])
}

model Expense {
  id           Int      @id @default(autoincrement())
  date         DateTime
  ledgerId     Int
  ledger       Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  amount       Float
  paymentMode  String
  bankLedgerId Int?
  reference    String?
  narration    String?
  partyName    String?
  createdBy    Int
  createdAt    DateTime @default(now())
}

model BankReconciliation {
  id            Int      @id @default(autoincrement())
  journalId     Int
  journal       Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  statementDate DateTime
  statementRef  String?
  reconciled    Boolean  @default(false)
  reconciledAt  DateTime?
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
}

model CostCenter {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MigrationLog {
  id              Int      @id @default(autoincrement())
  source          String
  dataType        String
  filename        String?
  recordsImported Int      @default(0)
  recordsSkipped  Int      @default(0)
  errors          String?
  status          String
  createdBy       Int
  createdAt       DateTime @default(now())
}
